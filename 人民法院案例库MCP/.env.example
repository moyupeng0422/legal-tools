# 人民法院案例库 MCP Server 配置
# 复制此文件为 .env 并填写配置

# ── 自动登录（推荐）──
# 按需登录模式：Token 过期时由 rmfyalk_auto_login 工具自动打开浏览器登录刷新
# 需配置人民法院案例库（rmfyalk.court.gov.cn）账号密码
RMFYALK_USERNAME=
RMFYALK_PASSWORD=

# ── 手动 Token（可选，自动登录失效时兜底）──
# 从浏览器 Cookie 中获取 faxin-cpws-al-token 的值：
# 登录 rmfyalk.court.gov.cn → F12 → Application → Cookies
RMFYALK_TOKEN=

# ── 导出目录（rmfyalk_export_case 工具）──
# 案例导出到 Obsidian 的根目录；留空则导出到脚本运行目录
EXPORT_DIR=
